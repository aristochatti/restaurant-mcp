# Google Places API key — enable "Places API (New)" on your Google Cloud project.
GOOGLE_MAPS_API_KEY=AIzaSyCJqEI3Eq2ERvo_-oA1GicTK4GMeitd0aI

# Port the MCP server listens on (optional, defaults to 3000).
# Alpic injects MCP_HTTP_PORT automatically in production — no need to set it there.
MCP_HTTP_PORT=3000

# Optional: comma-separated Host allowlist for DNS-rebinding protection,
# e.g. "my-server.alpic.live" (":*" wildcards allowed). Left empty the check is
# disabled — a public MCP endpoint isn't in that threat model, and pinning it
# to the wrong value makes every request 421.
MCP_ALLOWED_HOSTS=
